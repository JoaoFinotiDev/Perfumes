# Copie este arquivo para .env e preencha os valores (o .env nunca vai para o GitHub).
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=loja_perfumes
# Segredo que assina o cookie de sessao. Preencha com um texto longo e aleatorio (so seu, nunca no GitHub).
# Em producao (NODE_ENV=production) o app NAO sobe se estiver vazio ou igual ao texto de exemplo.
# Para gerar um:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
KODEBAR_TOKEN=
# (Opcional) Endereço do site usado na prévia do link (LinkedIn, WhatsApp...: título, descrição e logo).
# Vazio: usa o endereço que chegou no pedido (ex.: http://localhost:3000 quando você abre no seu PC).
# Para a prévia funcionar FORA da sua rede, coloque o endereço acessível de fora, ex.: http://IP-EXTERNO:3000
# (troque IP-EXTERNO pelo IP externo da máquina que roda o site). A prévia do LinkedIn só aparece se esse
# endereço abrir pela internet; senão o post mostra só o texto/vídeo.
SITE_URL=
