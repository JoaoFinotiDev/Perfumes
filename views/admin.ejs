<%# Tela do admin: cria vendedores e lista os existentes. %>
<%- include('partials/topo', { titulo: 'Vendedores' }) %>
<h1>Vendedores</h1>
<% if (erro) { %><p class="erro" role="alert"><%= erro %></p><% } %>
<form method="post" action="/admin/vendedores" class="form">
  <%# Dicas: cada campo aponta para o seu texto de ajuda (aria-describedby), que o leitor de tela lê junto.
      autocomplete="new-password": o navegador pode sugerir uma senha forte (é uma conta nova). %>
  <label>Nome <input name="nome" value="<%= form.nome || '' %>" required maxlength="100" autocomplete="off"></label>
  <label>Usuário <input name="usuario" value="<%= form.usuario || '' %>" required maxlength="30" autocomplete="off" autocapitalize="none" spellcheck="false" aria-describedby="dica-usuario"></label>
  <small id="dica-usuario" class="dica">Até 30 caracteres, sem espaços. É com ele que se entra no site.</small>
  <label>Senha <input type="password" name="senha" required minlength="6" maxlength="72" autocomplete="new-password" aria-describedby="dica-senha"></label>
  <small id="dica-senha" class="dica">Mínimo de 6 caracteres.</small>
  <button type="submit">Criar vendedor</button>
</form>
<%# Caixa com rolagem lateral: no celular a tabela rola dentro dela, sem alargar a página (style.css). %>
<div class="tabela-rolagem"><table>
  <thead><tr><th>ID</th><th>Nome</th><th>Usuário</th></tr></thead>
  <tbody>
  <% vendedores.forEach(function (v) { %>
    <tr><td><%= v.id %></td><td><%= v.nome %></td><td><%= v.usuario %></td></tr>
  <% }) %>
  <% if (!vendedores.length) { %><tr><td colspan="3">Nenhum vendedor ainda.</td></tr><% } %>
  </tbody>
</table>
</div>
<%- include('partials/rodape') %>
