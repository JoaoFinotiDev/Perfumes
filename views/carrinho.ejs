<%# Carrinho do site. Pagamento simulado. O desconto vem do usuário logado (contas prontas em resumo). %>
<%- include('partials/topo', { titulo: 'Carrinho' }) %>
<h1>Carrinho</h1>
<% if (erro) { %><p class="erro" role="alert"><%= erro %></p><% } %>
<% if (!resumo.linhas.length) { %>
  <p>Seu carrinho está vazio. <a href="/">Ver vitrine</a></p>
<% } else { %>
  <%# Tabela e totais: mesma partial da tela "Abrir venda". %>
  <%- include('partials/itens-carrinho', { resumo: resumo, acaoRemover: '/carrinho/remover', acaoQuantidade: '/carrinho/quantidade' }) %>
  <%# Economia = desconto já calculado em CarrinhoService.resumir (a view não faz conta). %>
  <% if (resumo.temDesconto) { %><p class="destaque economia">Você economizou <%= moeda(resumo.desconto) %> nesta compra.</p><% } %>
  <p><a href="/">&larr; Continuar comprando</a></p>

  <%# Esta tela só abre para o Cliente (a rota confere no servidor), então o botão de finalizar sempre aparece. %>
  <%# data-enviar-uma-vez: depois do clique o botão trava (evita compra em dobro no duplo clique). %>
  <form method="post" action="/carrinho/finalizar" class="form" data-enviar-uma-vez>
    <label>Forma de pagamento (simulado)
      <select name="forma" required>
        <% Object.keys(formas).forEach(function (k) { %><option value="<%= k %>"><%= formas[k] %></option><% }) %>
      </select>
    </label>
    <button type="submit">Finalizar compra</button>
  </form>
<% } %>
<script src="/javascripts/enviar-uma-vez.js"></script>
<%- include('partials/rodape') %>
