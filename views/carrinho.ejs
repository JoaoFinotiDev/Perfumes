<%# Carrinho do site. Pagamento simulado. O desconto vem do usuário logado. %>
<%- include('partials/topo', { titulo: 'Carrinho' }) %>
<h1>Carrinho</h1>
<% if (erro) { %><p class="erro"><%= erro %></p><% } %>
<% if (carrinho.estaVazio()) { %>
  <p>Seu carrinho está vazio. <a href="/">Ver vitrine</a></p>
<% } else { %>
  <table>
    <thead><tr><th>Produto</th><th>Qtd</th><th>Preço unit.</th><th>Subtotal</th><th></th></tr></thead>
    <tbody>
    <% carrinho.itens.forEach(function (i) { const unit = i.precoPara(usuario); %>
      <tr>
        <td><%= i.nome %> - <%= i.perfume.marca %></td>
        <td><%= i.quantidade %></td>
        <td><%= moeda(unit) %></td>
        <td><%= moeda(unit * i.quantidade) %></td>
        <td>
          <form method="post" action="/carrinho/remover" class="inline">
            <input type="hidden" name="perfumeId" value="<%= i.perfume.id %>">
            <input type="hidden" name="variacaoId" value="<%= i.variacao ? i.variacao.id : '' %>">
            <button type="submit" class="link">Remover</button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  <%# Os valores ja vem calculados pelo controller (resumo); aqui so mostramos. %>
  <p>Subtotal: <%= moeda(resumo.subtotal) %></p>
  <% if (resumo.temDesconto) { %><p>Desconto de cliente (<%= resumo.percentualTexto %>): -<%= moeda(resumo.desconto) %></p><% } %>
  <p class="total">Total: <%= moeda(resumo.total) %></p>

  <%# Esta tela só abre para o Cliente (a rota confere no servidor), então o botão de finalizar sempre aparece. %>
  <form method="post" action="/carrinho/finalizar" class="form">
    <label>Forma de pagamento (simulado)
      <select name="forma" required>
        <% Object.keys(formas).forEach(function (k) { %><option value="<%= k %>"><%= formas[k] %></option><% }) %>
      </select>
    </label>
    <button type="submit">Finalizar compra</button>
  </form>
<% } %>
<%- include('partials/rodape') %>
