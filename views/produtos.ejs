<%# Gerenciar produtos (Vendedor/Admin): lista com busca, botão Editar e mostrar/ocultar na vitrine. A view só MOSTRA. %>
<%- include('partials/topo', { titulo: 'Gerenciar produtos' }) %>
<h1>Gerenciar produtos</h1>
<% if (erro) { %><p class="erro"><%= erro %></p><% } %>
<p class="dica">Produto oculto não aparece na vitrine nem pode ser comprado pelo site, mas continua na tela "Abrir venda".</p>

<form method="get" action="/vendedor/produtos" class="busca">
  <input name="q" value="<%= busca %>" placeholder="Buscar por nome ou marca" maxlength="80">
  <button type="submit">Buscar</button>
</form>

<table>
  <thead>
    <tr><th>Foto</th><th>ID</th><th>Nome</th><th>Marca</th><th>Preço</th><th>Estoque (editar)</th><th>Na vitrine</th><th>Ações</th></tr>
  </thead>
  <tbody>
  <% perfumes.forEach(function (p) { %>
    <tr>
      <td><% if (p.fotoUrl) { %><img src="<%= p.fotoUrl %>" alt="<%= p.nome %>" class="foto"><% } %></td>
      <td><%= p.id %></td>
      <td>
        <a href="/produto/<%= p.id %>"><%= p.nome %></a>
        <%# SKU e pontos pequenos, quando houver (pontos só existem na marca Queen Semijoias). %>
        <% if (p.sku || p.pontos !== null) { %><br><small class="dica"><%= p.sku ? 'SKU ' + p.sku : '' %><%= p.sku && p.pontos !== null ? ' · ' : '' %><%= p.pontos !== null ? p.pontos + ' pontos' : '' %></small><% } %>
      </td>
      <td><%= p.marca %></td>
      <td><%= moeda(p.preco) %></td>
      <td>
        <% if (p.temVariacoes()) { %>
        <%# Produto com variações: mostra o total (soma) e leva para a edição, onde cada variação tem o seu estoque. %>
        <%= p.estoqueDe() %> (total)<br><a href="/vendedor/produtos/<%= p.id %>/editar">editar variações</a>
        <% } else { %>
        <%# Estoque rápido (POST): campo numérico + Salvar, e -1 / +1 que enviam o valor já calculado.
            O servidor valida de novo (inteiro >= 0). Sem JS tudo funciona, pois são formulários comuns. %>
        <form method="post" action="/vendedor/produtos/<%= p.id %>/estoque" class="inline estoque-form">
          <input type="hidden" name="q" value="<%= busca %>">
          <input type="number" name="estoque" value="<%= p.estoque %>" min="0" step="1" required class="estoque-campo" aria-label="Estoque de <%= p.nome %>">
          <button type="submit">Salvar</button>
        </form>
        <% [-1, 1].forEach(function (passo) { %>
        <form method="post" action="/vendedor/produtos/<%= p.id %>/estoque" class="inline">
          <input type="hidden" name="q" value="<%= busca %>">
          <input type="hidden" name="estoque" value="<%= Math.max(0, p.estoque + passo) %>">
          <button type="submit" aria-label="<%= passo < 0 ? 'Tirar' : 'Pôr' %> 1 do estoque de <%= p.nome %>"<%= passo < 0 && p.estoque <= 0 ? ' disabled' : '' %>><%= passo < 0 ? '-1' : '+1' %></button>
        </form>
        <% }) %>
        <% } %>
      </td>
      <td><%= p.visivel ? 'Sim' : 'Não' %></td>
      <td>
        <a href="/vendedor/produtos/<%= p.id %>/editar">Editar</a>
        <%# Mostrar/ocultar é um POST (muda dados), com o valor novo escondido no formulário. %>
        <form method="post" action="/vendedor/produtos/<%= p.id %>/visibilidade" class="inline">
          <input type="hidden" name="visivel" value="<%= p.visivel ? '0' : '1' %>">
          <input type="hidden" name="q" value="<%= busca %>">
          <button type="submit"><%= p.visivel ? 'Ocultar da vitrine' : 'Mostrar na vitrine' %></button>
        </form>
      </td>
    </tr>
  <% }) %>
  <% if (!perfumes.length) { %><tr><td colspan="8">Nenhum produto encontrado.</td></tr><% } %>
  </tbody>
</table>
<%- include('partials/rodape') %>
