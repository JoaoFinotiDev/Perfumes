<%# Gerenciar produtos (Vendedor/Admin): lista com busca, botão Editar e mostrar/ocultar na vitrine. A view só MOSTRA. %>
<%- include('partials/topo', { titulo: 'Gerenciar produtos' }) %>
<h1>Gerenciar produtos</h1>
<% if (erro) { %><p class="erro" role="alert"><%= erro %></p><% } %>
<p class="dica">Produto oculto não aparece na vitrine nem pode ser comprado pelo site, mas continua na tela "Abrir venda".
  Produto com variações: clique na seta (ou na linha) para ver e editar cada variação.</p>

<form method="get" action="/vendedor/produtos" class="busca">
  <input name="q" value="<%= busca %>" placeholder="Buscar por nome ou marca" maxlength="80">
  <button type="submit">Buscar</button>
</form>

<%
  // Controle de estoque rápido, igual para o produto e para a variação, numa linha só:
  //   [ − ] [ campo ] [ + ] [Salvar]
  // São 3 formulários (−1, +1 e Salvar), todos para o mesmo POST (`acao`). O campo numérico fica FORA do
  // formulário do Salvar, mas pertence a ele pelo atributo form="..." (assim a ordem na tela e a do Tab ficam iguais).
  // `aberto` faz a lista voltar com as variações daquele produto expandidas; `chave` deixa o id do formulário único.
  // O servidor valida de novo (inteiro >= 0). Sem JS tudo funciona, pois são formulários comuns.
  function controlesDeEstoque(acao, estoque, nome, aberto, chave) {
    const idForm = 'estoque-' + chave;
    // Um botão −1 ou +1: formulário próprio que já envia o valor novo (nunca abaixo de 0).
    function passo(n) {
%>
    <form method="post" action="<%= acao %>" class="inline">
      <input type="hidden" name="q" value="<%= busca %>">
      <% if (aberto) { %><input type="hidden" name="aberto" value="<%= aberto %>"><% } %>
      <input type="hidden" name="estoque" value="<%= Math.max(0, estoque + n) %>">
      <button type="submit" class="botao-pequeno botao-passo" aria-label="<%= n < 0 ? 'Tirar' : 'Pôr' %> 1 do estoque de <%= nome %>"<%= n < 0 && estoque <= 0 ? ' disabled' : '' %>><%= n < 0 ? '−' : '+' %></button>
    </form>
<%  } %>
  <div class="estoque-controle">
    <% passo(-1); %>
    <input type="number" name="estoque" form="<%= idForm %>" value="<%= estoque %>" min="0" step="1" required class="estoque-campo" aria-label="Estoque de <%= nome %>">
    <% passo(1); %>
    <form method="post" action="<%= acao %>" id="<%= idForm %>" class="inline">
      <input type="hidden" name="q" value="<%= busca %>">
      <% if (aberto) { %><input type="hidden" name="aberto" value="<%= aberto %>"><% } %>
      <button type="submit" class="botao-pequeno">Salvar</button>
    </form>
  </div>
<% } %>

<%# Caixa com rolagem lateral: no celular a tabela rola dentro dela, sem alargar a página (style.css). %>
<div class="tabela-rolagem"><table class="tabela-gestao">
  <thead>
    <tr><th class="col-foto">Foto</th><th>ID</th><th>Nome</th><th>Marca</th><th>Preço</th><th>Estoque</th><th>Na vitrine</th><th>Ações</th></tr>
  </thead>
  <tbody>
  <% perfumes.forEach(function (p) {
       // Linhas filhas: TODAS as variações (ativas e inativas), para poder ligar de novo uma inativa.
       const filhas = p.variacoes.map(function (x) { return 'var-' + p.id + '-' + x.id; });
  %>
    <tr id="produto-<%= p.id %>"<%= filhas.length ? ' data-linha-produto' : '' %>>
      <td class="col-foto"><% if (p.fotoUrl) { %><img src="<%= p.fotoUrl %>" alt="<%= p.nome %>" class="foto-mini"><% } %></td>
      <td><%= p.id %></td>
      <td>
        <%# Seta (só com JS: nasce escondida). aria-expanded diz se está aberta; aria-controls aponta as linhas filhas. %>
        <% if (filhas.length) { %>
          <button type="button" class="seta" data-seta hidden aria-expanded="true" aria-controls="<%= filhas.join(' ') %>"
                  aria-label="Mostrar ou esconder as variações de <%= p.nome %>"><span aria-hidden="true">&gt;</span></button>
        <% } %>
        <a href="/produto/<%= p.id %>"><%= p.nome %></a>
        <%# SKU e pontos pequenos, quando houver (pontos só existem na marca Queen Semijoias). %>
        <% if (p.sku || p.pontos !== null) { %><br><small class="dica"><%= p.sku ? 'SKU ' + p.sku : '' %><%= p.sku && p.pontos !== null ? ' · ' : '' %><%= p.pontos !== null ? p.pontos + ' pontos' : '' %></small><% } %>
      </td>
      <td><%= p.marca %></td>
      <%# Com variações ativas: preço "a partir de" (o menor) e estoque TOTAL, sem campo (o estoque é de cada variação). %>
      <td class="sem-quebra"><%= p.temVariacoes() ? 'a partir de ' : '' %><%= moeda(p.precoBase()) %></td>
      <td>
        <% if (p.temVariacoes()) { %>
          <%= p.estoqueDe() %> (total)
        <% } else { controlesDeEstoque('/vendedor/produtos/' + p.id + '/estoque', p.estoque, p.nome, 0, 'p' + p.id); } %>
      </td>
      <td><%= p.visivel ? 'Sim' : 'Não' %></td>
      <td class="acoes">
        <a href="/vendedor/produtos/<%= p.id %>/editar" class="botao-pequeno botao-link">Editar</a>
        <%# Mostrar/ocultar é um POST (muda dados), com o valor novo escondido no formulário. %>
        <form method="post" action="/vendedor/produtos/<%= p.id %>/visibilidade" class="inline">
          <input type="hidden" name="visivel" value="<%= p.visivel ? '0' : '1' %>">
          <input type="hidden" name="q" value="<%= busca %>">
          <button type="submit" class="botao-pequeno"><%= p.visivel ? 'Ocultar da vitrine' : 'Mostrar na vitrine' %></button>
        </form>
      </td>
    </tr>
    <%# Linhas das variações. Sem JS ficam sempre visíveis; com JS começam recolhidas
        (menos a do produto em ?aberto=<id>, que volta aberta depois de uma mudança). %>
    <% p.variacoes.forEach(function (x) { const nomeVar = p.nome + ' - ' + x.descricao; %>
    <tr id="var-<%= p.id %>-<%= x.id %>" class="linha-variacao<%= x.ativo ? '' : ' variacao-inativa' %>" data-filha-de="<%= p.id %>"<%= aberto === p.id ? ' data-aberta' : '' %>>
      <td class="col-foto"></td>
      <td><small class="dica"><%= x.id %></small></td>
      <td class="variacao-nome"><%= x.descricao %></td>
      <td></td>
      <td class="sem-quebra"><%= moeda(x.preco) %></td>
      <td><% controlesDeEstoque('/vendedor/produtos/' + p.id + '/variacoes/' + x.id + '/estoque', x.estoque, nomeVar, p.id, 'v' + x.id); %></td>
      <td><%= x.ativo ? 'Ativa' : 'Inativa' %></td>
      <td class="acoes">
        <a href="/vendedor/produtos/<%= p.id %>/editar#variacoes" class="botao-pequeno botao-link">Editar</a>
        <%# Ativar/desativar: variação inativa some da vitrine, da página do produto e de "Abrir venda". %>
        <form method="post" action="/vendedor/produtos/<%= p.id %>/variacoes/<%= x.id %>/ativo" class="inline">
          <input type="hidden" name="ativo" value="<%= x.ativo ? '0' : '1' %>">
          <input type="hidden" name="q" value="<%= busca %>">
          <input type="hidden" name="aberto" value="<%= p.id %>">
          <button type="submit" class="botao-pequeno" aria-label="<%= x.ativo ? 'Desativar' : 'Ativar' %> a variação <%= nomeVar %>"><%= x.ativo ? 'Desativar' : 'Ativar' %></button>
        </form>
      </td>
    </tr>
    <% }) %>
  <% }) %>
  <% if (!perfumes.length) { %><tr><td colspan="8">Nenhum produto encontrado.</td></tr><% } %>
  </tbody>
</table>
</div>
<script src="/javascripts/gestao-variacoes.js"></script>
<%- include('partials/rodape') %>
