<%# Página do produto (GET /produto/:id): foto grande, descrição completa, SKU, pontos (só Queen Semijoias),
    seletor de variação, preço, estoque, quantidade e "Adicionar ao carrinho". A view só MOSTRA: os valores chegam prontos. %>
<%- include('partials/topo', { titulo: p.nome }) %>
<p><a href="/">&larr; Voltar para a vitrine</a></p>
<% if (!p.visivel) { %><p class="dica">Este produto está oculto da vitrine (só você, que gerencia produtos, vê esta página).</p><% } %>
<% if (percentualDesconto) { %><p class="destaque">Você tem <%= percentualDesconto %>% de desconto em todos os preços.</p><% } %>
<article class="produto-pagina">
  <div class="produto-foto">
    <%# Foto grande: é a principal da página, então NÃO é lazy (aparece logo); decoding="async" não trava a página.
        Com foto: o link abre a foto inteira (funciona sem JS); o JS (zoom-foto.js) troca por uma janela com zoom. %>
    <% if (p.fotoUrl) { %>
      <a href="<%= p.fotoUrl %>" class="foto-zoom" data-zoom aria-label="Ampliar a foto de <%= p.nome %>">
        <img src="<%= p.fotoUrl %>" alt="<%= p.nome %>" decoding="async" fetchpriority="high"
             onerror="this.onerror=null;this.src='/images/sem-foto.svg';">
      </a>
    <% } else { %>
      <img src="/images/sem-foto.svg" alt="<%= p.nome %>" decoding="async">
    <% } %>
  </div>
  <div class="produto-info">
    <span class="card-marca"><%= p.marca %></span>
    <h1><%= p.nome %></h1>
    <%# SKU e pontos só aparecem quando existem (pontos só vêm preenchidos para a marca Queen Semijoias). %>
    <% if (p.sku) { %><p class="dica">SKU: <%= p.sku %></p><% } %>
    <% if (p.pontos !== null) { %><p class="dica">Pontos: <%= p.pontos %></p><% } %>
    <%- include('partials/produto-compra', { p: p, ctx: 'pagina' }) %>
    <% if (!mostrarCarrinho) { %><p class="dica">Vendedor e Admin vendem pela tela "Abrir venda".</p><% } %>
    <h2>Descrição</h2>
    <p class="produto-descricao"><%= p.descricao || 'Sem descrição.' %></p>
  </div>
</article>
<script src="/javascripts/comprar.js"></script>
<script src="/javascripts/zoom-foto.js"></script>
<%- include('partials/rodape') %>
