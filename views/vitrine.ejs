<%# Vitrine (GET /): cards de produtos estilo marketplace, com busca, filtro por marca e ordenação.
    A view só MOSTRA: preço com desconto, marcas e ordem já chegam prontos do PerfumeService. %>
<%- include('partials/topo', { titulo: 'Vitrine' }) %>
<%# Cabeçalho da vitrine: logo pequeno e uma frase curta de boas-vindas. %>
<div class="vitrine-cabecalho">
  <img src="/images/logo.jpg" alt="Lojinha Chic" class="vitrine-logo" width="64" height="64">
  <div>
    <h1>Vitrine</h1>
    <p class="dica">Bem-vindo à Lojinha Chic: perfumes com todo o charme.</p>
  </div>
</div>
<%# temDesconto vem do controller (pergunta à estratégia de desconto de quem está logado). %>
<% if (percentualDesconto) { %><p class="destaque">Você tem <%= percentualDesconto %>% de desconto em todos os preços.</p><% } %>

<%# Barra de busca: GET com ?q=&marca=&ordem=. Os valores atuais voltam preenchidos. %>
<form method="get" action="/" class="vitrine-busca">
  <input type="search" name="q" value="<%= busca %>" placeholder="Buscar por nome ou marca" maxlength="80" aria-label="Buscar por nome ou marca"
         data-busca-lista data-url="/api/produtos" autocomplete="off">
  <%# Marca e ordem filtram assim que são escolhidas (data-envia-ao-mudar; veja public/javascripts/envia-ao-mudar.js).
      Sem JavaScript, o botão "Buscar" continua fazendo o mesmo. %>
  <select name="marca" aria-label="Filtrar por marca" data-envia-ao-mudar>
    <option value="">Todas as marcas</option>
    <% marcas.forEach(function (m) { %>
      <option value="<%= m %>"<%= m === marca ? ' selected' : '' %>><%= m %></option>
    <% }) %>
  </select>
  <select name="ordem" aria-label="Ordenar por" data-envia-ao-mudar>
    <option value="nome"<%= ordem === 'nome' ? ' selected' : '' %>>Nome (A-Z)</option>
    <option value="menor-preco"<%= ordem === 'menor-preco' ? ' selected' : '' %>>Menor preço</option>
    <option value="maior-preco"<%= ordem === 'maior-preco' ? ' selected' : '' %>>Maior preço</option>
  </select>
  <%# Quantos produtos por página. O form não envia "pagina", então mudar busca, marca, ordem ou isto volta à página 1. %>
  <label class="vitrine-por-pagina">Mostrar:
    <select name="porPagina" data-envia-ao-mudar>
      <% opcoesPorPagina.forEach(function (n) { %>
        <option value="<%= n %>"<%= n === paginacao.porPagina ? ' selected' : '' %>><%= n %></option>
      <% }) %>
    </select>
  </label>
  <button type="submit">Buscar</button>
</form>

<% if (!cards.length) { %>
  <p class="dica">Nenhum perfume encontrado.</p>
<% } else { %>
<%# Faixa da página atual (os números vêm prontos de domain/Paginacao.js). %>
<p class="dica vitrine-faixa">Mostrando <%= paginacao.inicio %>-<%= paginacao.fim %> de <%= paginacao.total %> produto<%= paginacao.total === 1 ? '' : 's' %></p>
<ul class="vitrine-grade">
  <% cards.forEach(function (p) { %>
  <li class="card<%= p.esgotado ? ' card-esgotado' : '' %>">
    <div class="card-imagem">
      <%# Sem foto (ou foto que falhar ao carregar): troca por um desenho local, sem serviço externo. %>
      <%# A foto e o nome abrem a página do produto. O seletor e o botão ficam FORA destes links (o card inteiro NÃO é um link). %>
      <a href="/produto/<%= p.id %>" aria-label="Abrir <%= p.nome %>">
        <img src="<%= p.fotoUrl || '/images/sem-foto.svg' %>" alt="<%= p.nome %>" loading="lazy"
             onerror="this.onerror=null;this.src='/images/sem-foto.svg';">
      </a>
      <% if (p.temDesconto) { %><span class="selo">-<%= p.percentual %>%</span><% } %>
    </div>
    <div class="card-corpo">
      <span class="card-marca"><%= p.marca %></span>
      <h2 class="card-nome" title="<%= p.nome %>"><a href="/produto/<%= p.id %>"><%= p.nome %></a></h2>
      <%# (card-codigos some no celular, veja style.css; na página do produto SKU e pontos aparecem sempre.) %>
      <%# SKU e pontos pequenos, quando houver (pontos só vêm preenchidos para a marca Queen Semijoias). %>
      <% if (p.sku || p.pontos !== null) { %><p class="dica card-codigos"><%= p.sku ? 'SKU ' + p.sku : '' %><%= p.sku && p.pontos !== null ? ' · ' : '' %><%= p.pontos !== null ? p.pontos + ' pontos' : '' %></p><% } %>
      <%# Preço, selo de estoque, chips de variação e quantidade (bloco compartilhado com a página do produto). %>
      <%- include('partials/produto-compra', { p: p, ctx: 'card' }) %>
    </div>
  </li>
  <% }) %>
</ul>
<%# Controles só embaixo (em cima já há busca, filtros e a faixa; repetir deixaria a página poluída). %>
<% if (paginacao.totalPaginas > 1) { %>
<nav class="paginacao" aria-label="Paginação">
  <% if (links.anterior) { %><a href="<%= links.anterior %>" rel="prev">Anterior</a><% } else { %><span class="paginacao-desativado">Anterior</span><% } %>
  <% links.paginas.forEach(function (item) { %>
    <% if (!item) { %><span class="paginacao-reticencias" aria-hidden="true">…</span>
    <% } else if (item.atual) { %><a href="<%= item.href %>" class="paginacao-atual" aria-current="page"><%= item.numero %></a>
    <% } else { %><a href="<%= item.href %>" aria-label="Página <%= item.numero %>"><%= item.numero %></a><% } %>
  <% }) %>
  <% if (links.proxima) { %><a href="<%= links.proxima %>" rel="next">Próxima</a><% } else { %><span class="paginacao-desativado">Próxima</span><% } %>
</nav>
<% } %>
<% } %>
<%# Busca em lista suspensa com pesquisa gradual (melhoria: sem JS, o formulário acima continua funcionando). %>
<script src="/javascripts/busca-lista.js"></script>
<script src="/javascripts/comprar.js"></script>
<script src="/javascripts/envia-ao-mudar.js"></script>
<%- include('partials/rodape') %>
