<%# Tela "Abrir venda" do vendedor: cliente opcional, busca, código de barras e pagamento. %>
<%- include('partials/topo', { titulo: 'Abrir venda' }) %>
<h1>Abrir venda</h1>
<% if (erro) { %><p class="erro" role="alert"><%= erro %></p><% } %>

<h2>1. Cliente (opcional)</h2>
<form method="post" action="/vendedor/venda/cliente" class="inline-form">
  <select name="clienteId">
    <option value="0">Sem cliente (preço cheio)</option>
    <% clientes.forEach(function (c) { %>
      <option value="<%= c.id %>" <%= cliente && cliente.id === c.id ? 'selected' : '' %>><%= c.nome %> (<%= c.usuario %>)</option>
    <% }) %>
  </select>
  <button type="submit">Aplicar</button>
</form>
<% if (cliente) { %><p class="destaque">Cliente: <%= cliente.nome %> - desconto de <%= resumo.percentualTexto %> aplicado.</p><% } %>

<h2>2. Adicionar produto</h2>
<form method="post" action="/vendedor/venda/codigo" class="inline-form">
  <label>Código de barras <input name="codigo" id="codigo" autofocus autocomplete="off" inputmode="numeric" maxlength="14" placeholder="Bipe aqui e Enter"></label>
  <button type="submit">Adicionar</button>
</form>
<form method="get" action="/vendedor/venda" class="inline-form">
  <%# Com JS, clicar neste campo abre a lista de produtos (inclusive ocultos); escolher um adiciona à venda (POST abaixo).
      O <label for> fica separado do campo de propósito: a lista suspensa é criada ao lado do campo. %>
  <div class="campo-busca">
    <label for="busca-q">Buscar por nome ou marca</label>
    <input id="busca-q" name="q" value="<%= busca %>" maxlength="80" autocomplete="off"
           data-busca-lista data-url="/api/produtos?todos=1" data-acao-post="/vendedor/venda/adicionar"
           data-variacoes-url="/api/produtos/{id}/variacoes" data-variacoes-bloco="venda-variacao">
  </div>
  <button type="submit">Buscar</button>
</form>
<%# Segunda busca (só com JS): aparece quando se escolhe um produto COM variações. Escondida (hidden) no começo.
    O campo de variação e a lista funcionam como a primeira busca (public/javascripts/busca-lista.js).
    Sem JS ela nunca aparece: vale a tabela de resultados abaixo, com o select de variação. %>
<div id="venda-variacao" class="campo-busca venda-variacao" hidden>
  <label for="variacao-q" data-variacao-rotulo>Variação</label>
  <input id="variacao-q" maxlength="80" autocomplete="off" placeholder="Escolha a variação" data-busca-variacao>
  <div class="inline-form">
    <label>Quantidade
      <input type="number" min="1" step="1" value="1" class="estoque-campo" data-variacao-quantidade>
    </label>
    <button type="button" class="link" data-trocar-produto>Trocar produto</button>
  </div>
</div>
<% if (busca) { %>
<%# Caixa com rolagem lateral: no celular a tabela rola dentro dela, sem alargar a página (style.css). %>
<div class="tabela-rolagem">
  <table>
    <thead><tr><th>Nome</th><th>Marca</th><th>Preço</th><th>Estoque</th><th></th></tr></thead>
    <tbody>
    <% resultados.forEach(function (p) { %>
      <tr>
        <td><%= p.nome %></td><td><%= p.marca %></td>
        <td><%= p.temVariacoes() ? 'a partir de ' : '' %><%= moeda(p.precoPara(cliente)) %></td><td><%= p.estoqueDe() %></td>
        <td>
          <form method="post" action="/vendedor/venda/adicionar" class="inline">
            <input type="hidden" name="perfumeId" value="<%= p.id %>">
            <%# Produto com variações: pede a variação (e o preço dela) antes de adicionar. %>
            <% if (p.temVariacoes()) { %>
              <label>Opção
                <select name="variacaoId" required aria-label="Opção de <%= p.nome %>">
                  <option value="">Escolha...</option>
                  <% p.variacoesAtivas.forEach(function (x) { %>
                    <option value="<%= x.id %>"<%= x.estoque <= 0 ? ' disabled' : '' %>><%= x.descricao %> - <%= moeda(p.precoPara(cliente, x)) %> (<%= x.estoque <= 0 ? 'esgotado' : x.estoque + ' em estoque' %>)</option>
                  <% }) %>
                </select>
              </label>
            <% } %>
            <input type="number" name="quantidade" value="1" min="1" step="1" class="estoque-campo" aria-label="Quantidade de <%= p.nome %>">
            <button type="submit">Adicionar</button>
          </form>
        </td>
      </tr>
    <% }) %>
    <% if (!resultados.length) { %><tr><td colspan="5">Nenhum produto encontrado.</td></tr><% } %>
    </tbody>
  </table>
</div>
<% } %>

<h2>3. Itens da venda</h2>
<% if (!resumo.linhas.length) { %>
  <p>Nenhum item ainda.</p>
<% } else { %>
  <%# Tabela e totais: mesma partial do carrinho do site (contas prontas em CarrinhoService.resumir). %>
  <%- include('partials/itens-carrinho', { resumo: resumo, acaoRemover: '/vendedor/venda/remover' }) %>

  <h2>4. Pagamento (simulado)</h2>
  <%# Trava o botão depois do clique (evita venda em dobro). %>
  <form method="post" action="/vendedor/venda/finalizar" class="inline-form" data-enviar-uma-vez>
    <select name="forma" required>
      <% Object.keys(formas).forEach(function (k) { %><option value="<%= k %>"><%= formas[k] %></option><% }) %>
    </select>
    <button type="submit">Finalizar venda</button>
  </form>
<% } %>
<script src="/javascripts/busca-lista.js"></script>
<script src="/javascripts/enviar-uma-vez.js"></script>
<%- include('partials/rodape') %>
