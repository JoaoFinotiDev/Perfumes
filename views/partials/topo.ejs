<%# Topo comum: cabeçalho, menu e aviso de uma exibição. Use com include('partials/topo', {titulo}). %>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> - Lojinha Chic</title>
  <%# Favicon: o mesmo logo redondo da loja aparece na aba do navegador. %>
  <link rel="icon" href="/images/logo.jpg">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
<header class="topo">
  <%# Marca da loja: logo redondo + nome, os dois levam para a vitrine (/). O alt do logo e o proprio nome. %>
  <a class="marca" href="/">
    <img src="/images/logo.jpg" alt="Lojinha Chic" class="marca-logo" width="48" height="48">
    <span class="marca-nome">Lojinha Chic</span>
  </a>
  <nav>
    <a href="/">Vitrine</a>
    <a href="/itens">Catálogo (tabela)</a>
    <a href="/carrinho">Carrinho</a>
    <%# Estes links so MOSTRAM o menu certo para cada papel. Quem barra de verdade e o middleware exigirPapel. %>
    <% if (usuario && usuario.papel === 'vendedor') { %><a href="/vendedor/venda">Abrir venda</a><% } %>
    <% if (usuario && usuario.papel === 'admin') { %><a href="/admin">Vendedores</a><% } %>
    <% if (usuario) { %>
      <form action="/logout" method="post" class="inline">
        <span class="quem"><%= usuario.nome %> (<%= usuario.papel %>)</span>
        <button type="submit" class="link">Sair</button>
      </form>
    <% } else { %>
      <a href="/login">Entrar</a>
      <a href="/cadastro">Cadastrar</a>
    <% } %>
  </nav>
</header>
<main>
<% if (aviso) { %><p class="aviso"><%= aviso %></p><% } %>
