<%# Topo comum: cabeçalho, menu e aviso de uma exibição. Use com include('partials/topo', {titulo}). %>
<%#
  Valores padrão: a página de erro pode ser desenhada ANTES do middleware que preenche usuario, mostrarCarrinho e aviso
  (por exemplo, quando a sessão falha). Com `locals.` a variável que não existe vira o padrão em vez de quebrar a página.
%>
<% const usuario = locals.usuario || null; const mostrarCarrinho = locals.mostrarCarrinho !== false; const aviso = locals.aviso || null; %>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> - Lojinha Chic</title>
  <%# Favicon: o mesmo logo redondo da loja aparece na aba do navegador. %>
  <link rel="icon" href="/images/logo.jpg">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
<header class="topo">
  <%# Marca da loja: logo redondo + nome, os dois levam para a vitrine (/). O alt do logo é o próprio nome. %>
  <a class="marca" href="/">
    <img src="/images/logo.jpg" alt="Lojinha Chic" class="marca-logo" width="48" height="48">
    <span class="marca-nome">Lojinha Chic</span>
  </a>
  <nav>
    <a href="/">Vitrine</a>
    <%# A tabela do catálogo só aparece para quem gerencia produtos; a rota GET /itens também barra os outros no servidor. %>
    <% if (usuario && usuario.podeGerenciar()) { %><a href="/itens">Catálogo (tabela)</a><% } %>
    <%# mostrarCarrinho vem pronto do middleware (visitante e Cliente veem; Vendedor e Admin não). A rota também barra no servidor. %>
    <% if (mostrarCarrinho) { %><a href="/carrinho">Carrinho</a><% } %>
    <%# Estes links só MOSTRAM o menu certo para cada papel. Quem barra de verdade é o middleware exigirPapel. %>
    <% if (usuario && usuario.ehVendedor()) { %><a href="/vendedor/venda">Abrir venda</a><% } %>
    <%# "Gerenciar produtos" aparece para quem a regra Usuario.podeGerenciar() libera (Vendedor e Admin). %>
    <% if (usuario && usuario.podeGerenciar()) { %><a href="/vendedor/produtos">Gerenciar produtos</a><% } %>
    <% if (usuario && usuario.ehAdmin()) { %><a href="/admin">Vendedores</a><% } %>
    <% if (usuario) { %>
      <form action="/logout" method="post" class="inline">
        <span class="quem"><%= usuario.nome %> (<%= usuario.papel %>)</span>
        <button type="submit" class="link">Sair</button>
      </form>
    <% } else { %>
      <a href="/login">Entrar</a>
      <a href="/cadastro">Cadastrar</a>
    <% } %>
  </nav>
</header>
<main>
<% if (aviso) { %><p class="aviso"><%= aviso %></p><% } %>
