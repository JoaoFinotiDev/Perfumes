<%#
  Tabela de itens + totais, IGUAL no carrinho do site e na tela "Abrir venda".
  Entrada: resumo (pronto em CarrinhoService.resumir: linhas, subtotal, desconto, total) e
  acaoRemover (endereço do POST do botão "Remover").
  A view só MOSTRA: preço unitário, subtotal de cada linha e os totais já vêm calculados.
%>
<%# Caixa com rolagem lateral: no celular a tabela rola dentro dela, sem alargar a página (style.css). %>
<div class="tabela-rolagem"><table>
  <thead><tr><th>Produto</th><th>Qtd</th><th>Preço unit.</th><th>Subtotal</th><th></th></tr></thead>
  <tbody>
  <% resumo.linhas.forEach(function (linha) { %>
    <tr>
      <td><%= linha.nome %> - <%= linha.marca %></td>
      <td><%= linha.quantidade %></td>
      <td><%= moeda(linha.unitario) %></td>
      <td><%= moeda(linha.subtotal) %></td>
      <td>
        <form method="post" action="<%= acaoRemover %>" class="inline">
          <input type="hidden" name="perfumeId" value="<%= linha.perfumeId %>">
          <input type="hidden" name="variacaoId" value="<%= linha.variacaoId %>">
          <button type="submit" class="link">Remover</button>
        </form>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<p>Subtotal: <%= moeda(resumo.subtotal) %></p>
<% if (resumo.temDesconto) { %><p>Desconto de cliente (<%= resumo.percentualTexto %>): -<%= moeda(resumo.desconto) %></p><% } %>
<p class="total">Total: <%= moeda(resumo.total) %></p>
