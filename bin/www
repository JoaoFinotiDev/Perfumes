#!/usr/bin/env node

/**
 * bin/www
 * Ponto de partida do servidor (npm start). O app.js só monta o Express;
 * aqui a gente abre a porta e fica ouvindo as requisições.
 */

/**
 * Dependências do arquivo.
 */

var app = require('../app');
var debug = require('debug')('loja-perfumes:server'); // mensagens de depuração (aparecem com DEBUG=loja-perfumes:*)
var http = require('http');

/**
 * Pega a porta do ambiente (PORT no .env) ou usa 3000, e guarda no Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Cria o servidor HTTP.
 */

var server = http.createServer(app);

/**
 * Começa a ouvir na porta escolhida, em todas as interfaces de rede.
 */

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Converte o valor da porta em número, nome de pipe ou false (inválido).
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // não é número: pode ser um "named pipe" (canal nomeado do sistema)
    return val;
  }

  if (port >= 0) {
    // número de porta válido
    return port;
  }

  return false;
}

/**
 * Trata o evento "error" do servidor (por exemplo, porta já ocupada).
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // mostra mensagens amigáveis para os erros mais comuns ao abrir a porta
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges'); // precisa de permissão de administrador
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use'); // outra aplicação já usa esta porta
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Trata o evento "listening": o servidor abriu a porta com sucesso.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
